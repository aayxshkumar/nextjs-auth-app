# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/nextjs-auth-app

# Secret used to sign the login JWT
TOKEN_SECRET=change-me

# Base URL used in verification email links
DOMAIN=http://localhost:3000

# Mailtrap sandbox SMTP credentials (sandbox.smtp.mailtrap.io:2525)
MAILTRAP_USER=your-mailtrap-user
MAILTRAP_PASS=your-mailtrap-password
